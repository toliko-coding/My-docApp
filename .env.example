# Copy this file to .env and fill in your own Supabase project's values.
# Get these from: Supabase Dashboard -> Project Settings -> API
#
# EXPO_PUBLIC_* variables are inlined into the client bundle at build time,
# so ONLY ever put values here that are safe to ship to a device — the
# Supabase anon key is designed for exactly that (Row Level Security is what
# actually protects user data, not keeping this key secret).
#
# NEVER put the Supabase service_role key, or any OCR/AI provider secret key,
# in an EXPO_PUBLIC_ variable — those must only ever be used server-side
# (e.g. a Supabase Edge Function), never inside this mobile app.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Which DocumentProcessor implementation to use (see
# src/services/document-processor). Leave unset in development to fall back
# to the mock provider. Real values are added when a Phase 4 OCR/AI vendor
# is wired up, e.g. "google-document-ai" | "openai-vision".
EXPO_PUBLIC_DOCUMENT_PROCESSOR=
